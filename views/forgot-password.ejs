<section class="panel">
  <h1>Forgot password</h1>
  <p class="lede">Enter your account email and we’ll generate a reset link.</p>
  <form method="post" action="/forgot-password" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label>
      Email
      <input type="email" name="email" required autocomplete="email" />
    </label>
    <button type="submit" class="btn">Send reset link</button>
  </form>
  <% if (typeof resetUrl !== 'undefined' && resetUrl) { %>
    <p class="muted" style="margin-top: 1rem;">
      Dev reset link:
      <a href="<%= resetUrl %>"><%= resetUrl %></a>
    </p>
  <% } %>
  <p class="muted"><a href="/login">Back to login</a></p>
</section>
